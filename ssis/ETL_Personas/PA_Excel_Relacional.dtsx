                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          name="Expression">(ISNULL(#{Package\DFT 1 Extraer limpiar y validar\CNV Convertir tipos.Outputs[Data Conversion Output].Columns[C_Id]}) ? "SourceRowId no válido; " : "") + (ISNULL(#{Package\DFT 1 Extraer limpiar y validar\DER 2 Estandarizar categorias y formatos.Outputs[Derived Column Output].Columns[TipoDoc]}) ? "Tipo de documento faltante; " : (#{Package\DFT 1 Extraer limpiar y validar\DER 2 Estandarizar categorias y formatos.Outputs[Derived Column Output].Columns[TipoDoc]} == "CC" || #{Package\DFT 1 Extraer limpiar y validar\DER 2 Estandarizar categorias y formatos.Outputs[Derived Column Output].Columns[TipoDoc]} == "CE" || #{Package\DFT 1 Extraer limpiar y validar\DER 2 Estandarizar categorias y formatos.Outputs[Derived Column Output].Columns[TipoDoc]} == "PA") ? "" : "Tipo de documento no válido (" + #{Package\DFT 1 Extraer limpiar y validar\DER 2 Estandarizar categorias y formatos.Outputs[Derived Column Output].Columns[TipoDoc]} + "); ") + (ISNULL(#{Package\DFT 1 Extraer limpiar y validar\DER 2 Estandarizar categorias y formatos.Outputs[Derived Column Output].Columns[NumDoc]}) ? "Documento faltante; " : ISNULL(#{Package\DFT 1 Extraer limpiar y validar\CNV Convertir tipos.Outputs[Data Conversion Output].Columns[C_NumDocDigitos]}) ? "Documento con formato no válido (" + #{Package\DFT 1 Extraer limpiar y validar\DER 2 Estandarizar categorias y formatos.Outputs[Derived Column Output].Columns[NumDoc]} + "); " : "") + (ISNULL(#{Package\DFT 1 Extraer limpiar y validar\DER 2 Estandarizar categorias y formatos.Outputs[Derived Column Output].Columns[Nombre1]}) ? "Primer nombre faltante; " : "") + (ISNULL(#{Package\DFT 1 Extraer limpiar y validar\DER 2 Estandarizar categorias y formatos.Outputs[Derived Column Output].Columns[Apellido1]}) ? "Primer apellido faltante; " : "") + (ISNULL(#{Package\DFT 1 Extraer limpiar y validar\DER 2 Estandarizar categorias y formatos.Outputs[Derived Column Output].Columns[FNacTxt]}) ? "Fecha de nacimiento faltante; " : ISNULL(#{Package\DFT 1 Extraer limpiar y validar\CNV Convertir tipos.Outputs[Data Conversion Output].Columns[C_FNac]}) ? "Fecha de nacimiento no válida (" + #{Package\DFT 1 Extraer limpiar y validar\DER 1 Normalizar textos.Outputs[Derived Column Output].Columns[L_FNac]} + "); " : (!ISNULL(#{Package\DFT 1 Extraer limpiar y validar\CNV Convertir tipos.Outputs[Data Conversion Output].Columns[C_FEnc]}) &amp;&amp; #{Package\DFT 1 Extraer limpiar y validar\CNV Convertir tipos.Outputs[Data Conversion Output].Columns[C_FNac]} &gt; #{Package\DFT 1 Extraer limpiar y validar\CNV Convertir tipos.Outputs[Data Conversion Output].Columns[C_FEnc]}) ? "Fecha de nacimiento posterior a la encuesta (" + #{Package\DFT 1 Extraer limpiar y validar\DER 1 Normalizar textos.Outputs[Derived Column Output].Columns[L_FNac]} + "); " : "") + (ISNULL(#{Package\DFT 1 Extraer limpiar y validar\DER 2 Estandarizar categorias y formatos.Outputs[Derived Column Output].Columns[FEncTxt]}) ? "Fecha de encuesta faltante; " : ISNULL(#{Package\DFT 1 Extraer limpiar y validar\CNV Convertir tipos.Outputs[Data Conversion Output].Columns[C_FEnc]}) ? "Fecha de encuesta no válida (" + #{Package\DFT 1 Extraer limpiar y validar\DER 1 Normalizar textos.Outputs[Derived Column Output].Columns[L_FEnc]} + "); " : #{Package\DFT 1 Extraer limpiar y validar\CNV Convertir tipos.Outputs[Data Conversion Output].Columns[C_FEnc]} &gt; GETDATE() ? "Fecha de encuesta futura; " : "") + (ISNULL(#{Package\DFT 1 Extraer limpiar y validar\CNV Convertir tipos.Outputs[Data Conversion Output].Columns[C_Edad]}) ? "Edad reportada no válida; " : "") + (ISNULL(#{Package\DFT 1 Extraer limpiar y validar\DER 2 Estandarizar categorias y formatos.Outputs[Derived Column Output].Columns[IngTxt]}) ? "MonthlyIncome faltante; " : ISNULL(#{Package\DFT 1 Extraer limpiar y validar\CNV Convertir tipos.Outputs[Data Conversion Output].Columns[C_Ing]}) ? "MonthlyIncome no numérico (" + #{Package\DFT 1 Extraer limpiar y validar\DER 1 Normalizar textos.Outputs[Derived Column Output].Columns[L_Ing]} + "); " : #{Package\DFT 1 Extraer limpiar y validar\CNV Convertir tipos.Outputs[Data Conversion Output].Columns[C_Ing]} &lt; 0 ? "MonthlyIncome negativo (" + #{Package\DFT 1 Extraer limpiar y validar\DER 1 Normalizar textos.Outputs[Derived Column Output].Columns[L_Ing]} + "); " : "") + (ISNULL(#{Package\DFT 1 Extraer limpiar y validar\DER 2 Estandarizar categorias y formatos.Outputs[Derived Column Output].Columns[GasTxt]}) ? "MonthlyExpenses faltante; " : ISNULL(#{Package\DFT 1 Extraer limpiar y validar\CNV Convertir tipos.Outputs[Data Conversion Output].Columns[C_Gas]}) ? "MonthlyExpenses no numérico (" + #{Package\DFT 1 Extraer limpiar y validar\DER 1 Normalizar textos.Outputs[Derived Column Output].Columns[L_Gas]} + "); " : #{Package\DFT 1 Extraer limpiar y validar\CNV Convertir tipos.Outputs[Data Conversion Output].Columns[C_Gas]} &lt; 0 ? "MonthlyExpenses negativo (" + #{Package\DFT 1 Extraer limpiar y validar\DER 1 Normalizar textos.Outputs[Derived Column Output].Columns[L_Gas]} + "); " : "")</property>
